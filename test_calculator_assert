from day1_assert_pytest.calculator import square


def main():
    test_square()


def test_square():
    # assert <condition>  -> does nothing if True, raises AssertionError if False.
    # Without try/except, the FIRST failure stops everything, and we don't learn
    # whether the later checks would have passed.
    try:
        assert square(2) == 4
    except AssertionError:
        print("2 squared was not 4")
    try:
        assert square(3) == 9
    except AssertionError:
        print("3 squared was not 9")
    try:
        assert square(-2) == 4
    except AssertionError:
        print("-2 squared was not 4")
    try:
        assert square(0) == 0
    except AssertionError:
        print("0 squared was not 0")
    print("Finished checking square()")


if __name__ == "__main__":
    main()
